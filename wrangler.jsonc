{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "92cb4bb9b2a55d24f5688f2f61864079",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"name": "scrmbld",
	"compatibility_date": "2026-01-26",
	"compatibility_flags": ["nodejs_als"],
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"observability": {
		"enabled": true,
	},
	"placement": {
		"mode": "smart",
	},
	"env": {
		"staging": {
			"name": "scrmbld-staging",
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "74bed334-9c30-43a3-82a5-9bd546b149ce",
					"database_name": "scrmbld-staging",
				},
			],
		},
		"production": {
			"name": "scrmbld",
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "864ce78f-d55c-425a-ba45-7d770e8c1f5b",
					"database_name": "scrmbld",
				},
			],
		},
	},
}
