{
	"name": "scrmbld",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"seed": "bun scripts/seed.js",
		"db:migrate:local": "wrangler d1 migrations apply scrmbld-staging --local --env preview",
		"db:migrate:remote": "wrangler d1 migrations apply scrmbld --remote",
		"db:migrate:preview": "wrangler d1 migrations apply scrmbld-staging --remote --env preview",
		"generate:vapid": "node scripts/generate-vapid-keys.js",
		"notifications:deploy": "wrangler deploy -c workers/notifications/wrangler.jsonc",
		"notifications:dev": "wrangler dev -c workers/notifications/wrangler.jsonc",
		"notifications:tail": "wrangler tail scrmbld-notifications"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250617.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.12.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.2",
		"@types/eslint": "^9.6.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.13.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"sass": "^1.83.0",
		"svelte": "^5.14.2",
		"svelte-check": "^4.1.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1",
		"vite": "^6.0.3",
		"wrangler": "4.63.0"
	},
	"type": "module",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	},
	"dependencies": {
		"@cf-wasm/resvg": "^0.3.3",
		"@floating-ui/core": "^1.6.8",
		"@floating-ui/dom": "^1.6.12",
		"@sveltejs/adapter-cloudflare": "^7.1.0",
		"better-auth": "^1.4.17",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"resend": "^6.8.0",
		"satori": "^0.19.1",
		"svelte-confetti": "^2.2.0",
		"ua-parser-js": "^2.0.0"
	}
}
